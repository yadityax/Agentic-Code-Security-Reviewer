# Copy to .env — never commit real values.
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://acsr:acsr@localhost:5433/acsr
REDIS_URL=redis://localhost:6380/0

# GitHub
GITHUB_WEBHOOK_SECRET=change-me
# Fine-grained PAT on the test repo (read-only until Week 4)
GITHUB_TOKEN=

# LLM (single provider behind an interface)
# groq | anthropic
LLM_PROVIDER=groq
ANTHROPIC_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
SCAN_TOKEN_BUDGET=200000

# Groq (OpenAI-compatible API)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Groq key limit is 8000 TPM; keep headroom
LLM_TOKENS_PER_MINUTE=7000

# Dashboard / approval API. Empty disables the API entirely (fail closed). Generate: openssl rand -hex 24
ADMIN_API_TOKEN=

# Behaviour switches
ENABLE_CODEQL=true
ENABLE_DISCOVERY=true
# Generate and verify patches after a scan. PRs are still opened only after a human approves.
ENABLE_REMEDIATION=false
# Post the report as a PR comment
POST_PR_COMMENTS=true
# Remediation PRs: needs a token with contents:write. Leave false until you trust the verified fixes.
ALLOW_GITHUB_WRITE=false
# Demo / dry-run: no GitHub API calls, clone from a local directory instead
GITHUB_OFFLINE=false
GIT_BASE_URL=https://github.com
