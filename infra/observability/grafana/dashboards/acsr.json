{
 "title": "Agentic Security Reviewer",
 "uid": "acsr",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "DS_PROMETHEUS",
    "type": "datasource",
    "query": "prometheus",
    "current": {}
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "title": "Scans per hour",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "sum(increase(acsr_scans_total[1h])) by (status)",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "title": "Scan latency p50 / p95",
   "type": "timeseries",
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum(rate(acsr_scan_latency_seconds_bucket[15m])) by (le))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.95, sum(rate(acsr_scan_latency_seconds_bucket[15m])) by (le))",
     "legendFormat": "p95",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "title": "Scans in flight",
   "type": "stat",
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "acsr_scans_in_flight",
     "legendFormat": "in flight",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "title": "Scanner duration p95",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum(rate(acsr_tool_duration_seconds_bucket[15m])) by (le, tool))",
     "legendFormat": "{{tool}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "title": "Scanner failures",
   "type": "timeseries",
   "gridPos": {
    "x": 8,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "sum(increase(acsr_tool_errors_total[1h])) by (tool)",
     "legendFormat": "{{tool}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "title": "Findings by severity and verdict",
   "type": "timeseries",
   "gridPos": {
    "x": 16,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "sum(increase(acsr_findings_total[1h])) by (severity, verdict)",
     "legendFormat": "{{severity}} / {{verdict}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 7,
   "title": "LLM tokens per hour",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "sum(increase(acsr_llm_tokens_total[1h])) by (kind)",
     "legendFormat": "{{kind}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 8,
   "title": "LLM cost (USD, cumulative)",
   "type": "timeseries",
   "gridPos": {
    "x": 8,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "sum(acsr_llm_cost_usd_total)",
     "legendFormat": "cost",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   }
  },
  {
   "id": 9,
   "title": "Remediation outcomes",
   "type": "timeseries",
   "gridPos": {
    "x": 16,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "sum(increase(acsr_remediations_total[1h])) by (outcome)",
     "legendFormat": "{{outcome}}",
     "refId": "A"
    }
   ]
  }
 ]
}